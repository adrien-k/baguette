{
  "name": "baguette",
  "version": "0.0.1",
  "description": "Self-hosted Claude Code agent sessions on GitHub repo worktrees",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"VITE_SERVER_ENABLED=true npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "NODE_ENV=development node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "install:all": "\"$npm_execpath\" install && cd client && \"$npm_execpath\" install",
    "build": "npm run build --prefix client",
    "start": "NODE_ENV=production node server/index.js",
    "migrate": "node scripts/migrate-latest.js",
    "migrate:make": "knex migrate:make --knexfile knexfile.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "lint:exports": "ESLINT_CHECK_UNUSED_EXPORTS=1 eslint . --cache --cache-location node_modules/.cache/eslint-exports",
    "lint:ci": "\"$npm_execpath\" run lint && \"$npm_execpath\" run lint:exports",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "\"$npm_execpath\" run lint:fix && \"$npm_execpath\" run format",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix --cache --cache-location node_modules/.cache/eslint",
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@anthropic-ai/sdk": "^0.102.0",
    "@cursor/sdk": "^1.0.37",
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@feathersjs/knex": "^5.0.46",
    "@feathersjs/schema": "^5.0.46",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "latest",
    "cookie": "^2.0.1",
    "cookie-parser": "latest",
    "cookie-signature": "latest",
    "dotenv": "latest",
    "ejs": "latest",
    "express": "^4.22.3",
    "feathers": "6.0.0-pre.11",
    "js-yaml": "^5.2.3",
    "knex": "latest",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typebox": "1.3.27",
    "ws": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "latest",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
