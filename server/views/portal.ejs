<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Preview services</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: monospace; background: #0d1117; color: #e6edf3; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; padding: 2rem; }
    h1 { font-size: 0.85rem; color: #8b949e; font-weight: normal; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.5rem; }
    a.service { display: flex; align-items: center; justify-content: space-between; gap: 2rem; background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 0.85rem 1.25rem; width: 100%; max-width: 400px; text-decoration: none; color: #e6edf3; }
    a.service:hover { border-color: #58a6ff; background: #1c2128; }
    .name { font-size: 1rem; }
    .arrow { color: #58a6ff; font-size: 1rem; }
  </style>
</head>
<body>
  <h1>Preview services</h1>
  <% services.forEach(function(svc) { %>
  <a class="service" href="<%= svc.url %>" target="_blank" rel="noopener noreferrer">
    <span class="name"><%= svc.name %></span>
    <span class="arrow">↗</span>
  </a>
  <% }); %>
</body>
</html>
