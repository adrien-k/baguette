AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Slug of your GitHub App (the <slug> in github.com/apps/<slug>). Set it to scope Baguette to the
# repositories you grant it at install time; leave empty to use a classic OAuth App instead, which
# gets access to every repo you can reach. See README > Using a GitHub App.
AUTH_GITHUB_APP_SLUG=
# At least 32 characters; used for cookie signing and encrypting the API key in DB (Settings > Agent)
ENCRYPTION_KEY=change-me-to-a-long-random-string-at-least-32-chars
PORT=3000
PUBLIC_HOST=http://localhost:5173

# Data directory for SQLite DB, repo clones, and worktrees (default: ~/.baguette)
DATA_DIR=./.data
