# Credentials of your GitHub App. See README > Setting up the GitHub App.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Slug of your GitHub App (the <slug> in github.com/apps/<slug>). Baguette is scoped to the
# repositories you grant the App at install time.
AUTH_GITHUB_APP_SLUG=
# At least 32 characters; used for cookie signing and encrypting the API key in DB (Settings > Agent)
ENCRYPTION_KEY=change-me-to-a-long-random-string-at-least-32-chars
PORT=3000
PUBLIC_HOST=http://localhost:5173
# Optional override for API/image URLs; defaults to PUBLIC_HOST when set, else http://localhost:3000 in dev
# PUBLIC_API_HOST=

# Data directory for SQLite DB, repo clones, and worktrees (default: ~/.baguette)
DATA_DIR=./.data

# ── Live agent-SDK integration tests (optional) ──────────────────────────────
# `pnpm test` skips these unless the matching key + model are set. They call a
# real model (cost + network) and assert turn status, MCP tools, RunTask, and
# usage rows. Leave blank unless you intend to run them.
#
# Claude (Anthropic API key *or* setup-token / gateway bearer):
SDK_TESTS_CLAUDE_API_KEY=
SDK_TESTS_CLAUDE_AUTH_TOKEN=
SDK_TESTS_CLAUDE_MODEL=
# Optional Anthropic-compatible gateway (e.g. OpenCode Go):
SDK_TESTS_CLAUDE_API_URL=
# Cursor (local cursor-agent binary must be available):
SDK_TESTS_CURSOR_API_KEY=
SDK_TESTS_CURSOR_MODEL=
SDK_TESTS_CURSOR_MODEL_PARAMS=
# Pi (SDK_TESTS_PI_API_KEY_ENV_VAR selects the provider, default ANTHROPIC_API_KEY):
SDK_TESTS_PI_API_KEY=
SDK_TESTS_PI_MODEL=
SDK_TESTS_PI_API_KEY_ENV_VAR=
#
# Cheap-model example (OpenCode Go + Cursor) — also wired as the
# `agents-integration-test` task in `.baguette.yaml` via Baguette secrets.
# Observed 2026-10-31, one harness turn each: Claude ~$0.0038, Cursor ~$0.0045,
# Pi ~$0.0051 (~$0.013 total). Cursor composer-2.5 was ~$0.028 — prefer glm-5p3-flash.
#   SDK_TESTS_CLAUDE_AUTH_TOKEN=<OPEN_CODE_GO_API_KEY>
#   SDK_TESTS_CLAUDE_API_URL=https://opencode.ai/inference/go/anthropic
#   SDK_TESTS_CLAUDE_MODEL=claude-haiku-5-5
#   SDK_TESTS_PI_API_KEY=<OPEN_CODE_GO_API_KEY>
#   SDK_TESTS_PI_MODEL=opencode-go/glm-5.3-flash
#   SDK_TESTS_PI_API_KEY_ENV_VAR=OPENCODE_GO_API_KEY
#   SDK_TESTS_CURSOR_API_KEY=<CURSOR_API_KEY>
#   SDK_TESTS_CURSOR_MODEL=glm-5p3-flash

# Mock SDK (no LLM; set to 1 to run the same harness against the scripted mock):
SDK_TESTS_MOCK=
# Optional timeout for a live turn in ms (default 180000):
SDK_TESTS_TIMEOUT_MS=
