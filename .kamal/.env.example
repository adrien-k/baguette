# Copy this file to .kamal/.env and fill in your values for local Kamal deploys.
# .kamal/.env is gitignored — never commit it.

# Your server's hostname or IP address
DEPLOY_SERVER=your-server-ip-or-hostname

# SSH user on the deploy server (default: ubuntu)
DEPLOY_USER=ubuntu

# Your domain (e.g. baguette.example.com — used for www.<DOMAIN>, *.<DOMAIN>, and acme.sh cert paths)
DOMAIN=your-domain.com

# Optional: Docker Hub (or other registry) instead of the local registry on the deploy server.
# When DOCKER_REGISTRY_USERNAME is set, images are pushed/pulled from the remote registry.
# DOCKER_IMAGE=your-dockerhub-user/baguette
# DOCKER_REGISTRY_USERNAME=your-dockerhub-user
# DOCKER_REGISTRY_PASSWORD=your-dockerhub-token-or-password
# DOCKER_REGISTRY_SERVER=ghcr.io   # omit for Docker Hub

# GitHub App credentials
AUTH_GITHUB_CLIENT_ID=xxxx
AUTH_GITHUB_CLIENT_SECRET=xxxx
# GitHub App slug (the <slug> in github.com/apps/<slug>)
AUTH_GITHUB_APP_SLUG=

# At least 32 random characters — used for cookie signing and secret encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
