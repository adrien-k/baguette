# Copy this file to .kamal/.env and fill in your values for local Kamal deploys.
# .kamal/.env is gitignored — never commit it.

# Optional — server to deploy to. Defaults to DOMAIN below; its apex DNS
# record must resolve over SSH. Examples: an IP or www.your-domain.com.
# DEPLOY_SERVER=your-server-ip-or-hostname

# SSH user on the deploy server (default: ubuntu)
# DEPLOY_USER=ubuntu

# Your domain (e.g. baguette.example.com — used for www.<DOMAIN>, *.<DOMAIN>,
# the apex <DOMAIN> (with wildcard DNS + cert it 301-redirects to www), and acme.sh cert paths)
DOMAIN=your-domain.com

# Optional: Docker Hub (or other registry) instead of the local registry on the deploy server.
# When DOCKER_REGISTRY_USERNAME is set, images are pushed/pulled from the remote registry.
# DOCKER_IMAGE=your-dockerhub-user/baguette
# DOCKER_REGISTRY_USERNAME=your-dockerhub-user
# DOCKER_REGISTRY_PASSWORD=your-dockerhub-token-or-password
# DOCKER_REGISTRY_SERVER=ghcr.io   # omit for Docker Hub

# Optional: one-time first-visitor gate (env-only; never copied to disk)
# BOOTSTRAP_PASSWORD=

# Optional. Set 1 only when Baguette runs behind Cloudflare, CloudFront, or App
# Engine, which set the client-country header. Default off — last-used country
# comes from a geoip lookup of the client IP.
# TRUST_EDGE_COUNTRY=

# Optional edge OIDC via oauth2-proxy (Kamal only). When set, Kamal boots an
# oauth2-proxy accessory in front of Baguette — see docs/deployment/kamal.md.
# OAUTH2_PROXY_PROVIDER=google
# OAUTH2_PROXY_EMAIL_DOMAINS=example.com
# OAUTH2_PROXY_CLIENT_ID=...
# OAUTH2_PROXY_CLIENT_SECRET=...
# OAUTH2_PROXY_COOKIE_SECRET=...   # openssl rand -base64 32
# OAUTH2_PROXY_COOKIE_DOMAINS=.your-domain.com   # optional — share auth across subdomains
# OAUTH2_PROXY_OIDC_ISSUER_URL=...               # optional — e.g. for oidc provider
