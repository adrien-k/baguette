# Secrets are read from environment variables.
# For local deploys, set them in .kamal/.env (gitignored — see .kamal/.env.example).
# In CI (GitHub Actions), they are provided as secrets/variables.

# Legacy, kept for backward compatibility: existing deployments that were
# configured with these keep working. New installs do not need them — the
# first-user wizard creates the GitHub App (or skip it for passkeys/PAT), and
# the first boot generates the encryption key into baguette_storage.
AUTH_GITHUB_CLIENT_ID=$AUTH_GITHUB_CLIENT_ID
AUTH_GITHUB_CLIENT_SECRET=$AUTH_GITHUB_CLIENT_SECRET
AUTH_GITHUB_APP_SLUG=$AUTH_GITHUB_APP_SLUG
ENCRYPTION_KEY=$ENCRYPTION_KEY
DOCKER_REGISTRY_PASSWORD=$DOCKER_REGISTRY_PASSWORD

# oauth2-proxy accessory (only when OAUTH2_PROXY_PROVIDER is set — see docs/deployment/kamal.md)
OAUTH2_PROXY_CLIENT_ID=$OAUTH2_PROXY_CLIENT_ID
OAUTH2_PROXY_CLIENT_SECRET=$OAUTH2_PROXY_CLIENT_SECRET
OAUTH2_PROXY_COOKIE_SECRET=$OAUTH2_PROXY_COOKIE_SECRET

# Certificate contents are fetched from the deploy server over SSH. The
# backslash-escaped defaults below are left for the shell by Kamal's dotenv
# secrets parser (DOMAIN is required and comes from the environment):
# DEPLOY_SERVER falls back to DOMAIN, DEPLOY_USER to ubuntu.
CERTIFICATE_PEM=$(ssh \${DEPLOY_USER:-ubuntu}@\${DEPLOY_SERVER:-\${DOMAIN}} "cat /home/\${DEPLOY_USER:-ubuntu}/.acme.sh/\${DOMAIN}_ecc/fullchain.cer")
PRIVATE_KEY_PEM=$(ssh \${DEPLOY_USER:-ubuntu}@\${DEPLOY_SERVER:-\${DOMAIN}} "cat /home/\${DEPLOY_USER:-ubuntu}/.acme.sh/\${DOMAIN}_ecc/\${DOMAIN}.key")
